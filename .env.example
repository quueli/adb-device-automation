# ui timings, seconds
UI_ELEMENT_WAIT_TIMEOUT=10
ADB_COMMAND_TIMEOUT=30
APP_LAUNCH_DELAY=3
BUTTON_TAP_DELAY=1
SCREEN_TRANSITION_DELAY=2
# pause between two tasks on the same device
TASK_COOLDOWN=5

# fixed: run the given number of tasks; continuous: until stop or empty pool
RUN_MODE=fixed

# 0 = never try uiautomator2, always use uiautomator dump
U2_ENABLED=1

# upstream socks5 the host relay forwards to (scripts/socks_relay.py)
PROXY_HOST=proxy.example.com
PROXY_USER=YOUR_USER
PROXY_PASS=YOUR_PASSWORD
# ports to try on that host: explicit list, or a range, or nothing for 10000-10009
PROXY_PORTS=10000,10001,10002
#PROXY_PORT_MIN=10000
#PROXY_PORT_MAX=10009
# where a socks5 connect through the proxy is attempted to prove it works
PROXY_CHECK_HOST=example.com
PROXY_CHECK_PORT=443
# port devices reach the relay on, through adb reverse
BROADCAST_LOCAL_PORT=1080
